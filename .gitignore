# Include this in the root of your Go project

# Binaries and Executables
# ------------------------
# Compiled applications
*.exe
*.exe~
*.dll
*.so
*.dylib

# Common Go binary outputs (add your specific binary name if preferred)
bin/
out/
dist/

# Test and Coverage Reports
# -------------------------
*.test
*.out
*.prof
*.pprof
coverage.txt

# Dependency Directories
# ----------------------
# Un-comment the line below if you vendor your dependencies 
# and do not want to commit the vendor folder.
# vendor/

# Go workspaces
go.work
go.work.sum

# Development Tools & IDEs
# ------------------------
# JetBrains / GoLand
.idea/
*.iml
*.iws

# Visual Studio Code
.vscode/
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json

# Vim / editor swap & temp files
*.swp
*.swo
*.swn
*~

# Delve debugger temporary binaries
__debug_bin

# Claude Code — commit the shared .claude/settings.json (team policy); keep
# personal overrides local and untracked.
.claude/settings.local.json

# Local Environment Variables
# ---------------------------
# Never commit credentials or secrets
.env
.env.local
.env.*.local

# macOS Specific
# --------------
.DS_Store
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.VolumeIcon.icns
.com.apple.timemachine.donotbackup

# Directories potentially created on macOS
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

/build
/docs/research


# Root build binaries (build to build/ instead; never track at repo root)
/twilightd
/dashboard

# Docs site (Docusaurus) — Node artifacts stay isolated under website/ and are
# never tracked; the docs site must not affect Go builds or release binaries.
/website/node_modules
/website/build
/website/.docusaurus
/website/.cache-loader
/website/.yarn
